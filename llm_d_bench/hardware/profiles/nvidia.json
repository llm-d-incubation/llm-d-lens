{
  "id": "nvidia",
  "display_name": "NVIDIA GPU",
  "vendor": "nvidia",
  "accelerator_keys": ["cuda", "nvidia", "nvidia_gpu"],
  "benchmark_profile": "nvidia",
  "upstream_variant": "gpu",
  "upstream_vendor": "nvidia",
  "request_model": "extended-resource",
  "device_classes": ["gpu.nvidia.com"],
  "resource_prefixes": ["nvidia.com/gpu"],
  "monitor_resource_suffixes": [],
  "node_label_selector": { "feature.node.kubernetes.io/pci-10de.present": "true" },
  "dranet_device_class": null,
  "access_modes": ["plugin", "dra"],
  "driver": {
    "installer": "helm",
    "modes": {
      "plugin": {
        "manifest_ref": "nvidia-device-plugin",
        "chart_version": "0.17.4",
        "repo": "https://nvidia.github.io/k8s-device-plugin",
        "daemonset_matchers": [
          { "name_contains": "nvidia-device-plugin" },
          { "label": "app.kubernetes.io/name=nvidia-device-plugin" }
        ],
        "options": {
          "nfd_enabled": true,
          "gfd_enabled": true,
          "runtime_class_name": "nvidia"
        }
      },
      "dra": {
        "manifest_ref": "nvidia-dra-driver-gpu",
        "chart_version": "25.8.0",
        "repo": "https://helm.ngc.nvidia.com/nvidia",
        "min_kubernetes_version": "1.32.0",
        "daemonset_matchers": [
          { "name_contains": "nvidia-dra-driver" },
          { "namespace": "nvidia-dra-driver-gpu" }
        ]
      }
    }
  },
  "presence": {
    "node_label_selector": { "feature.node.kubernetes.io/pci-10de.present": "true" },
    "ensure_refs": [],
    "timeout_seconds": 90,
    "poll_interval_seconds": 5
  },
  "telemetry": {
    "provider_id": "nvidia_gpu",
    "device_metrics": {
      "utilization": "DCGM_FI_DEV_GPU_UTIL",
      "framebuffer_used": "1024 * 1024 * DCGM_FI_DEV_FB_USED",
      "vram": "1024 * 1024 * (DCGM_FI_DEV_FB_FREE + DCGM_FI_DEV_FB_USED)",
      "memory_bandwidth_utilization": "DCGM_FI_PROF_DRAM_ACTIVE"
    },
    "device_metric_sources": {
      "utilization": { "metric": "DCGM_FI_DEV_GPU_UTIL", "unit": "percent", "output_unit": "percent", "aggregation": "avg", "tile_aggregation": "avg" },
      "framebuffer_used": { "metric": "DCGM_FI_DEV_FB_USED", "unit": "bytes", "scale": 1048576, "output_unit": "bytes", "aggregation": "sum", "tile_aggregation": "sum" },
      "memory_bandwidth_utilization": { "metric": "DCGM_FI_PROF_DRAM_ACTIVE", "unit": "ratio", "scale": 100, "output_unit": "percent", "aggregation": "avg", "tile_aggregation": "avg" }
    },
    "label_schema": { "node": "Hostname", "device": "gpu", "uuid": "UUID", "namespace": "namespace", "pod": "pod", "name": "modelName", "fallback_device": "UUID" },
    "allocation_join": "none",
    "pod_metrics": {
      "gpu_cache_usage": "vllm:gpu_cache_usage_perc",
      "gpu_memory_usage": "vllm:gpu_memory_usage_bytes"
    },
    "scrape_path": null,
    "source_label": "NVIDIA DCGM device telemetry",
    "allocation": {
      "drivers": ["gpu.nvidia.com"],
      "pci_attributes": ["pciAddress", "resource.kubernetes.io/pciBusID"],
      "node_labels": ["Hostname", "node"],
      "device_id_pattern": ""
    },
    "modes": {
      "dra": { "allocation_join": "dra" },
      "plugin": { "allocation_join": "extended-resource" }
    }
  },
  "deployment": {
    "overlay_root": "guides/{guide}/modelserver/{variant}/{model_server}",
    "arch": "gpu",
    "device_class": "gpu.nvidia.com",
    "claim_request_name": "nvidia",
    "node_selector": { "feature.node.kubernetes.io/pci-10de.present": "true" },
    "resource_name": "nvidia.com/gpu",
    "supports_pci_allowlist": false,
    "runtime_image": "docker.io/vllm/vllm-openai:v0.30.0",
    "managed_image_repositories": ["ghcr.io/llm-d/llm-d-cuda", "docker.io/vllm/vllm-openai"],
    "runtime_class_matchers": ["nvidia"],
    "pci_attribute": null,
    "pci_attribute_domain": null,
    "modes": {
      "dra": { "request_model": "dra", "device_class": "gpu.nvidia.com", "claim_request_name": "nvidia" },
      "plugin": {
        "request_model": "extended-resource",
        "resource_names": ["nvidia.com/gpu"]
      }
    }
  },
  "evaluation_profile": "nvidia",
  "planning": {
    "aic_system_patterns": ["h100|h200|b200|gb200|a100|l40|l4|nvidia"],
    "aic_system_models": [
      { "pattern": "\\ba100\\b", "system": "a100_sxm" }
    ],
    "model_label_keys": ["nvidia.com/gpu.product", "nvidia.com/gpu.family"],
    "default_backend": "vllm",
    "device_class_allow_pattern": "^(gpu\\.nvidia\\.com|nvidia\\.com)",
    "discovery": {
      "command": ["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader,nounits"],
      "format": "csv",
      "memory_divisor": 1024
    },
    "memory_models": []
  },
  "ui": { "icon": "Gpu", "labels": { "vendor": "NVIDIA", "metric_group": "GPU" } }
}
